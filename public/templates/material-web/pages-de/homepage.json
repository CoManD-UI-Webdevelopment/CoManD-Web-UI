{
  "metadata": {
    "title": "CoManD WebUI: Material-Web-Template",
    "description": "Kurzbeschreibung für Startseite",
    "rating": "",
    "robots": "index/follow",
    "author": ""
  },
  "heroSection": {
    "sections": [
      {
        "id": "welcome",
        "useInnerClass": true,
        "order": 1,
        "useFullDeviceWidth": false,
        "cmdHeadline": null,
        "components": [
          {
            "name": "CmdTabs",
            "id": "top-container",
            "props": {
              "stretchTabs": true,
              "useSlot": true,
              "useDefaultPadding": false,
              "tabs": [
                {
                  "tooltip": "Jetzt suchen",
                  "headlineText": "Tab 1 Headline",
                  "headlineLevel": 4,
                  "iconClass": "icon-search"
                },
                {
                  "tooltip": "Anmelden",
                  "headlineText": "Tab 2 Headline",
                  "headlineLevel": 4,
                  "iconClass": "icon-logon"
                }
              ]
            },
            "components": [
              {
                "name": "RegisterForm",
                "slotName": "tab-content-0",
                "props": {
                  "i18n": "$active",
                  "cmdForm": {
                    "class": "register-form",
                    "legend": {
                      "show": false,
                      "text": "Register"
                    },
                    "cmdLinkCancelButton": {
                      "show": false
                    },
                    "cmdLinkSubmitButton": {
                      "text": "Jetzt Partner finden"
                    }
                  }
                }
              },
              {
                "name": "CmdLoginForm",
                "slotName": "tab-content-1",
                "props": {
                  "cmdHeadlineLoginForm": {
                    "headlineText": "Jetzt registrieren und Partner finden!",
                    "headlineLevel": 3,
                    "textAlign": "center"
                  },
                  "legendLoginForm": {
                    "show": false,
                    "text": "Login form"
                  },
                  "cmdLinkLogin": {
                    "text": "Anmelden"
                  },
                  "cmdLinkForgotPassword": {
                      "text": "Passwort vergessen"
                  },
                  "cmdLinkCreateAccount": {
                    "text": "Jetzt registrieren"
                  },
                  "orientation": "vertical"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "mainContent": {
    "sections": [
      {
        "id": "new-members",
        "showLinkInMainNavigation": true,
        "navEntry": "Neue Mitglieder",
        "iconClass": "icon-user-profile",
        "allowAddComponent": true,
        "contentType": "flex",
        "contentOrientation": "horizontal",
        "innerClass": "some-class",
        "order": 6,
        "components": [
          {
            "name": "CmdBox",
            "props": {
              "id": "box-dating-tipps",
              "stretchVertically": true,
              "cmdHeadline": {
                "headlineLevel": 4,
                "headlineText": "Top 10 Dating-Tipps",
                "textAlign": "center"
              },
              "textBody": "Erhöhen Sie Ihre Flirtchancen mit diesen 10 Datingtipps.",
              "cmdImage": {
                "image": {
                  "src": "/media/images/content-images/couple2.jpg",
                  "alt": "Alternative Text"
                }
              },
              "cmdLink": {
                "linkType": "href",
                "path": "#",
                "icon": {
                  "iconClass": "icon-chevron-two-stripes-right",
                  "position": "right"
                },
                "text": "Mehr erfahren"
              }
            }
          },
          {
            "name": "CmdContainer",
            "props": {
              "id": "new-members-container",
              "containerType": "flex",
              "contentOrientation": "vertical"
            },
            "components": [
              {
                "name": "ThumbnailScrollerWrapper",
                "props": {
                  "cmdHeadline": {
                    "headlineText": "Neue männliche Mitglieder",
                    "headlineLevel": 3,
                    "textAlign": "center"
                  },
                  "gender": "male"
                }
              },
              {
                "name": "ThumbnailScrollerWrapper",
                "props": {
                  "cmdHeadline": {
                    "headlineText": "Neue weibliche Mitglieder",
                    "headlineLevel": 3,
                    "textAlign": "center"
                  },
                  "gender": "female"
                }
              }
            ]
          },
          {
            "name": "MostViewedProfilesWrapper"
          }
        ]
      },
      {
        "id": "services",
        "showLinkInMainNavigation": true,
        "navEntry": "Services",
        "iconClass": "icon-cogs",
        "allowAddComponent": true,
        "contentType": "flex",
        "contentOrientation": "vertical",
        "cmdHeadline": {
          "headlineText": "Unser Service für Sie",
          "headlineLevel": 2,
          "textAlign": "center"
        },
        "order": 6,
        "components": [
          {
            "name": "CmdBoxWrapper",
            "props": {
              "allowAddComponent": true,
              "allowUserToToggleOrientation": false,
              "boxesPerRow": 3,
              "useFlexbox": true,
              "useGap": true
            },
            "components": [
              {
                "name": "CmdBox",
                "props": {
                  "stretchVertically": true,
                  "cmdHeadline": {
                    "headlineLevel": 3,
                    "headlineText": "Verifizierte Profile",
                    "textAlign": "center"
                  },
                  "headlinePosition": "body",
                  "cmdIcon": {
                    "iconClass": "icon-check"
                  },
                  "textBody": "Wir stellen technisch und durch geschulte Mitarbeiter sicher, dass alle Profile auf unserer Plattform echt und sind"
                }
              },
              {
                "name": "CmdBox",
                "props": {
                  "stretchVertically": true,
                  "cmdHeadline": {
                    "headlineLevel": 3,
                    "headlineText": "Finde Deinen Partner weltweit",
                    "textAlign": "center"
                  },
                  "headlinePosition": "body",
                  "cmdIcon": {
                    "iconClass": "icon-globe"
                  },
                  "textBody": "Wir bieten weltweite Partnersuche in über 100 Ländern."
                }
              },
              {
                "name": "CmdBox",
                "props": {
                  "stretchVertically": true,
                  "cmdHeadline": {
                    "headlineLevel": 3,
                    "headlineText": "Sicherheit wird groß geschrieben",
                    "textAlign": "center"
                  },
                  "headlinePosition": "body",
                  "cmdIcon": {
                    "iconClass": "icon-security-settings"
                  },
                  "textBody": "Ihre Profildaten sind nur für angemeldet Mitglieder sichtbar und Ihre Privatsphäre wird von uns geschützt."
                }
              }
            ]
          }
        ]
      }
    ]
  }
}