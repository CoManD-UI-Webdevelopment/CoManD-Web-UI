{
  "siteHeader": {
    "navigationInline": true,
    "props": {
      "cmdCompanyLogo": {
        "pathDefaultLogo": "/media/images/logos/logo-dating.svg",
        "altText": "Company Logo"
      },
      "cmdMainNavigation": {
        "closeOffcanvas": {
          "iconClass": "icon-cancel",
          "text": "Close navigation",
          "showText": false
        }
      }
    }
  },
  "siteFooter": {
    "orientation": "horizontal",
    "components": [
      {
        "name": "CmdContainer",
        "allowAddComponent": true,
        "props": {
          "class": "flex-container vertical"
        },
        "components": [
          {
            "name": "CmdListOfLinks",
            "handlers": "toggleSection",
            "props": {
              "cmdHeadline": {
              },
              "orientation": "vertical",
              "textAlign": "right",
              "links": [
                {
                  "icon": {
                    "iconClass": "icon-security-settings"
                  },
                  "type": "href",
                  "text": "Data privacy",
                  "path": "/content/data-privacy-de.html",
                  "tooltip": "Open data privacy in FancyBox",
                  "fancybox": true
                },
                {
                  "icon": {
                    "iconClass": "icon-logon"
                  },
                  "type": "href",
                  "text": "Login",
                  "path": "#",
                  "sectionId": "section-login"
                },
                {
                  "icon": {
                    "iconClass": "icon-export"
                  },
                  "type": "href",
                  "text": "CoManD-Website",
                  "path": "https://www.comand-ui.com",
                  "target": "_blank",
                  "tooltip": "Open CoManD-website in a new tab"
                }
              ]
            }
          },
          {
            "name": "CmdToggleDarkMode",
            "props": {
              "showLabel": true,
              "labelTextDarkMode": "Dark Mode activated",
              "labelTextLightMode": "Light Mode activated"
            }
          }
        ]
      },
      {
        "name": "CmdSwitchLanguage",
        "props": {
          "pathFlags": "https://comand-ui.com/samples/images/flags",
          "languages": [
            {
              "iso2": "de",
              "name": "Deutsch",
              "tooltip": "Sprache zu deutsch wechseln",
              "link": {
                "type": "router"
              },
              "path": "/de"
            },
            {
              "iso2": "en",
              "name": "English",
              "tooltip": "Switch language to English",
              "link": {
                "type": "router"
              },
              "path": "/en"
            }
          ]
        }
      },
      {
        "name": "CmdOpeningHours",
        "props": {
          "textHolidays": "Holidays closed",
          "textMiscInfo": "Miscellaneous information",
          "openingHours": [
            {
